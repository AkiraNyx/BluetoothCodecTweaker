<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="BluetoothCodecTweaker.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="using:BluetoothCodecTweaker.Helpers"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <helpers:InfoBarSeverityConverter x:Key="InfoBarSeverityConverter" />
        <helpers:InfoBarVisibilityConverter x:Key="InfoBarVisibilityConverter" />
        <helpers:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <helpers:SupportStatusConverter x:Key="SupportStatusConverter" />
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="36,24,36,36" Spacing="16" MaxWidth="800">

            <TextBlock Text="蓝牙音频编码管理" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock Text="选择蓝牙音频设备并配置音频编码（Codec）"
                Style="{StaticResource BodyTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

            <InfoBar
                Title="{x:Bind ViewModel.InfoBarTitle, Mode=OneWay}"
                Message="{x:Bind ViewModel.InfoBarMessage, Mode=OneWay}"
                Severity="{x:Bind ViewModel.InfoBarState, Mode=OneWay, Converter={StaticResource InfoBarSeverityConverter}}"
                IsOpen="{x:Bind ViewModel.InfoBarState, Mode=OneWay, Converter={StaticResource InfoBarVisibilityConverter}}"
                IsClosable="True" />

            <!-- Device Selection -->
            <Grid Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="20">
                <StackPanel Spacing="12">
                    <Grid>
                        <TextBlock Text="蓝牙音频设备" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <Button HorizontalAlignment="Right" Command="{x:Bind ViewModel.RefreshDevicesCommand}"
                                ToolTipService.ToolTip="刷新" Style="{StaticResource SubtleButtonStyle}">
                            <FontIcon Glyph="&#xE72C;" FontSize="14" />
                        </Button>
                    </Grid>

                    <ProgressBar IsIndeterminate="True"
                        Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />

                    <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="WrapWholeWords" />

                    <ComboBox x:Name="DeviceSelector" HorizontalAlignment="Stretch"
                        PlaceholderText="请选择蓝牙音频设备" DisplayMemberPath="Name"
                        SelectedItem="{x:Bind ViewModel.SelectedDevice, Mode=TwoWay}" />
                </StackPanel>
            </Grid>

            <!-- Device Info -->
            <Grid Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="20"
                  Visibility="{x:Bind ViewModel.HasSelectedDevice, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="当前编码" Style="{StaticResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="{x:Bind ViewModel.SelectedDeviceCodecDisplay, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                </StackPanel>
                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                    <TextBlock Text="连接状态" Style="{StaticResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="{x:Bind ViewModel.SelectedDeviceConnectionDisplay, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}" />
                </StackPanel>
            </Grid>

            <!-- Codec Selection -->
            <Grid Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="20"
                  Visibility="{x:Bind ViewModel.HasSelectedDevice, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel Spacing="16">
                    <TextBlock Text="选择音频编码" Style="{StaticResource SubtitleTextBlockStyle}" />

                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.CodecOptions}">
                        <ItemsRepeater.Layout>
                            <StackLayout Spacing="8" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="16" CornerRadius="6" Tapped="OnCodecCardTapped"
                                      Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                      BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <RadioButton GroupName="CodecSelection"
                                        IsChecked="{Binding IsActive}" IsEnabled="{Binding IsEnabled}"
                                        VerticalAlignment="Center" MinWidth="0" Margin="0,0,8,0" />

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="{Binding DisplayName}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                        <TextBlock Text="{Binding Description}" Style="{StaticResource CaptionTextBlockStyle}"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="WrapWholeWords" MaxLines="2" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="12,0">
                                        <TextBlock Text="{Binding BitrateDisplay}" Style="{StaticResource CaptionTextBlockStyle}"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Right" />
                                        <TextBlock Text="{Binding QualityDisplay}" Style="{StaticResource CaptionTextBlockStyle}"
                                            Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Right" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>

                    <Button Content="应用编码" Style="{StaticResource AccentButtonStyle}"
                        Command="{x:Bind ViewModel.SwitchCodecCommand}" HorizontalAlignment="Right" MinWidth="120" />
                </StackPanel>
            </Grid>

            <!-- LDAC Info -->
            <Grid Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="20">
                <StackPanel Spacing="4">
                    <TextBlock Text="关于 LDAC 支持" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock TextWrapping="WrapWholeWords" Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                        <Run Text="LDAC 是 Sony 开发的高解析度蓝牙音频编码，Windows 11 尚未原生支持。本应用通过修改系统蓝牙 A2DP 参数来尝试启用 LDAC 编码。" />
                        <LineBreak />
                        <Run Text="若设备不支持所选编码，将自动建议回退至 AAC。切换编码需要管理员权限和蓝牙连接重启。" />
                    </TextBlock>
                </StackPanel>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</Page>
